<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Invoice Plan List: show the credit card fee applied on each installment -->
    <record id="view_sale_invoice_plan_list_inherit_card_fee" model="ir.ui.view">
        <field name="name">sale.invoice.plan.list.inherit.card.fee</field>
        <field name="model">sale.invoice.plan</field>
        <field name="inherit_id" ref="sale_invoice_plan.view_sale_invoice_plan_list" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="currency_id" column_invisible="True" />
                <field name="credit_card_fee_percent" optional="hide" />
                <field name="credit_card_fee_amount" optional="hide" />
            </field>
        </field>
    </record>

    <!-- Invoice Plan page of the sale order: credit card fee totals -->
    <record id="view_order_form_inherit_invoice_plan_card_fee" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.invoice.plan.card.fee</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_invoice_plan.view_order_form_invoice_plan" />
        <field name="arch" type="xml">
            <field name="invoice_plan_total_amount" position="after">
                <field
                    name="credit_card_fee_percent"
                    readonly="1"
                    invisible="not credit_card_fee_line_ids"
                />
                <field
                    name="credit_card_fee_amount"
                    readonly="1"
                    invisible="not credit_card_fee_line_ids"
                />
            </field>
        </field>
    </record>
</odoo>
