<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_card_fee" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.card.fee</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="payment_method_ids" position="after">
                <field name="credit_card_admin_id" />
                <field
                    name="credit_card_sum_fee"
                    invisible="not credit_card_fee_line_ids"
                />
                <field
                    name="credit_card_fee_line_ids"
                    nolabel="1"
                    invisible="not credit_card_fee_line_ids"
                >
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="True" />
                        <field name="payment_method_id" />
                        <field name="admin_id" />
                        <field name="installments_from" readonly="1" />
                        <field name="installments_to" readonly="1" />
                        <field name="fee_percent" />
                        <field name="amount" />
                        <field name="fee_amount" />
                    </list>
                </field>
            </field>
            <xpath
                expr="//group[@name='sale_total']/field[@name='tax_totals']"
                position="after"
            >
                <field
                    name="credit_card_fee_percent"
                    readonly="1"
                    invisible="not credit_card_fee_line_ids"
                />
                <field
                    name="credit_card_fee_amount"
                    readonly="1"
                    invisible="not credit_card_fee_line_ids"
                />
            </xpath>
        </field>
    </record>
</odoo>
