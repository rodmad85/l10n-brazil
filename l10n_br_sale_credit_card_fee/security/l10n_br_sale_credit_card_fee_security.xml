<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
    <record id="credit_card_admin_manager" model="res.groups">
        <field name="name">Credit Card Fee Manager</field>
        <field name="category_id" ref="base.module_category_localization" />
    </record>
    <record id="credit_card_fee_line_rule" model="ir.rule">
        <field name="name">Credit Card Fee Line multi-company</field>
        <field name="model_id" ref="model_credit_card_fee_line" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="base.user_admin" model="res.users">
        <field
            name="groups_id"
            eval="[Command.link(ref('credit_card_admin_manager'))]"
        />
    </record>
</odoo>
