<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_br_account_payment_brcobranca_form" model="ir.ui.view">
        <field name="name">l10n_br_account.payment.order.brcobranca.form</field>
        <field name="model">account.payment.order</field>
        <field name="priority">16</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_order_form"
        />
        <field name="arch" type="xml">
            <field name="payment_mode_id" position="after">
                <field
                    name="file_number"
                    attrs="{'readonly': [('state', 'not in', ('open', 'generated'))]}"
                />
            </field>
        </field>
    </record>
</odoo>
